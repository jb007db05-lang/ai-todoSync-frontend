{
  "name": "pristine-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky install",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "check:console": "tsx --tsconfig tsconfig.node.json src/scripts/checks/noConsoleCheck.ts",
    "check:branch": "tsx --tsconfig tsconfig.node.json src/scripts/checks/branchCheck.ts",
    "precommit": "npm run check:branch && npm run check:console && lint-staged",
    "prepush": "npm run type-check && npm run build && npm run check:branch && npm run check:console"
  },
  "lint-staged": {
    ".{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    ".{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.14.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.6.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.4.21"
  }
}
